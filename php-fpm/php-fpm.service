[Unit]
Description=The PHP FastCGI Process Manager
After=network.target

[Service]
Type=notify
PIDFile=/opt/php-7.4.cve/var/run/php-fpm.pid
ExecStart=/opt/php-7.4.cve/sbin/php-fpm --nodaemonize --fpm-config /opt/php-7.4.cve/etc/php-fpm.conf
ExecReload=/bin/kill -USR2 $MAINPID
PrivateTmp=true

[Install]
WantedBy=multi-user.target
